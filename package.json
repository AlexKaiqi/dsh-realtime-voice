{
  "name": "dsh-realtime-voice",
  "version": "0.1.0",
  "description": "Provider-neutral registered Realtime voice runtime for DeepSeek Harness assistants.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./service": "./dsh/service.js",
    "./package.json": "./package.json"
  },
  "files": ["dsh", "spec", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-multi-model-provider": "^0.1.0-rc.9"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-multi-model-provider": "link:../dsh-multi-model-provider"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-realtime-voice.git"
  },
  "bugs": {
    "url": "https://github.com/AlexKaiqi/dsh-realtime-voice/issues"
  },
  "homepage": "https://github.com/AlexKaiqi/dsh-realtime-voice#readme",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check dsh/index.js && node --check dsh/service.js && node --check dsh/transport.js && npm test"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "为多模型运行时注册 GPT Realtime 与豆包 Duplex 适配，并提供浏览器实时音频传输。",
        "en": "Registers GPT Realtime and Doubao Duplex adapters with the multi-model runtime and exposes browser audio transports."
      },
      "tags": ["voice", "realtime", "speech", "runtime"],
      "dependencies": ["dsh-multi-model-provider"]
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
