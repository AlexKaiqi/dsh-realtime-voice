{
  "name": "dsh-voice-agent",
  "version": "0.3.0",
  "description": "Provider-neutral full-duplex voice Agent capability for DeepSeek Harness.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./service": "./dsh/service.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": ["dsh", "client", "spec", "cordis.patch.yml", "plugin-spec.json", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-multi-model-provider": "^0.1.0-rc.9"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-multi-model-provider": "link:../dsh-multi-model-provider"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-voice-agent.git"
  },
  "bugs": {
    "url": "https://github.com/AlexKaiqi/dsh-voice-agent/issues"
  },
  "homepage": "https://github.com/AlexKaiqi/dsh-voice-agent#readme",
  "scripts": {
    "test": "node --test test/*.test.mjs test/*.test.cjs",
    "check": "node --check dsh/index.js && node --check dsh/service.js && node --check dsh/transport.js && node --check client/client.js && npm test"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "让产品与任意 Agent 开始可打断、可行动的全双工语音对话，底层适配 GPT Realtime 与豆包 Duplex。",
        "en": "Lets products start interruptible, action-capable full-duplex voice conversations with an Agent over GPT Realtime or Doubao Duplex."
      },
      "tags": ["voice", "agent", "duplex", "conversation"],
      "dependencies": ["dsh-multi-model-provider"]
    },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
