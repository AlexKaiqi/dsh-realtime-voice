{
  "name": "dsh-realtime-voice",
  "version": "0.1.0",
  "description": "Provider-neutral registered Realtime voice runtime for DeepSeek Harness assistants.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./service": "./dsh/service.js",
    "./package.json": "./package.json"
  },
  "files": ["dsh", "spec", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexKaiqi/dsh-realtime-voice.git"
  },
  "bugs": {
    "url": "https://github.com/AlexKaiqi/dsh-realtime-voice/issues"
  },
  "homepage": "https://github.com/AlexKaiqi/dsh-realtime-voice#readme",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check dsh/index.js && node --check dsh/service.js && node --check dsh/transport.js && npm test"
  },
  "dsh": {
    "inventory": {
      "summary": {
        "zh": "消费模型注册表中的 Realtime 语音模型，为 Session 助手和宠物提供统一的角色、工具与 Provider 会话装配。",
        "en": "Consumes registered Realtime speech models and assembles provider sessions, roles, and tools for session and pet assistants."
      },
      "tags": ["voice", "realtime", "speech", "runtime"],
      "dependencies": ["dsh-multi-model-provider", "@deepseek-ai/dsh-settings", "@deepseek-ai/dsh-credentials", "@deepseek-ai/dsh-llm"]
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
