{
  "version": 5,
  "name": "duplex-voice-agent",
  "runtime": "dsh-multi-model-provider/realtimeModelRuntime",
  "route": {
    "required": [
      "id",
      "model",
      "provider",
      "protocol",
      "adapter"
    ],
    "protocols": [
      "openai-webrtc",
      "doubao-realtime-duplex"
    ],
    "trustedOrigins": {
      "openai-webrtc": [
        "https://api.openai.com"
      ],
      "doubao-realtime-duplex": [
        "wss://openspeech.bytedance.com"
      ]
    },
    "browserAuthorization": {
      "httpMarkers": [
        "x-dsh-voice-agent",
        "x-dsh-model-probe"
      ],
      "websocketSubprotocol": "dsh-voice-agent-v1",
      "sameOrigin": true
    }
  },
  "clientService": {
    "name": "voiceAgent",
    "methods": [
      "capabilities",
      "startConversation",
      "registerActions"
    ],
    "compatibilityMethods": [
      "models",
      "open",
      "registerTools",
      "recognize",
      "readAloud"
    ],
    "capabilities": [
      "secureContext",
      "realtime",
      "recognition",
      "audioInput",
      "readAloud",
      "voices"
    ],
    "audioInput": {
      "ownership": "exclusive-lease",
      "ownerOption": "ownerId",
      "conflictCode": "audio_input_busy",
      "standbyPreemption": "recognize-preemptible",
      "release": "conversation-end-or-startup-failure"
    },
    "actionRegistry": {
      "registration": "registerActions(ownerPrefix, actions)",
      "ownerMatch": "conversation ownerId startsWith ownerPrefix",
      "resolution": "registered name → execute(args, control) → resolveAction; unknown name under a matched owner → error result; unmatched owner → consumer resolves",
      "asyncResults": "execute may return a Promise; speech continues while the result is pending (dual output); executors that never settle are resolved with a timeout error (action.timeoutMs per action, default 300000ms)",
      "control": "execute may call control.resolve(result, options) to settle before follow-up work",
      "events": "action-result emitted after every automatic resolution"
    },
    "conversation": [
      "id",
      "subscribe",
      "updateContext",
      "resolveAction",
      "interrupt",
      "end"
    ],
    "compatibilityConversationMethods": ["resolveTool", "close"],
    "events": {
      "status": [
        "connected",
        "status"
      ],
      "phase": [
        "phase"
      ],
      "transcript": [
        "role",
        "text",
        "final"
      ],
      "action": [
        "callId",
        "name",
        "arguments"
      ],
      "action-result": [
        "callId",
        "name",
        "ok",
        "output",
        "error"
      ],
      "error": [
        "code",
        "message",
        "recoverable"
      ],
      "closed": []
    }
  },
  "owns": [
    "provider-wire-protocol",
    "browser-transport",
    "browser-media-lifecycle",
    "audio-input-arbitration",
    "provider-event-normalization",
    "action-execution-loop",
    "dual-output-scheduling"
  ],
  "doesNotOwn": [
    "model-catalog",
    "credential-resolution",
    "role-profile",
    "drafts",
    "agent-submission",
    "knowledge",
    "delegation-policy"
  ]
}
